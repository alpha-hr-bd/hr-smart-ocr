rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All entitlement, payment, and OCR-code writes happen in trusted Cloud Functions.
    match /users/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /paymentRequests/{id} { allow read, write: if false; }
    match /ocrCodes/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
